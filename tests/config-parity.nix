# The config JSON generated by the module has exactly the fields of
# muelle.config.Config and Site, and Config.from_json loads it.
{
  pkgs,
  muelle,
  settings,
}:
pkgs.runCommand "muelle-config-parity"
  {
    nativeBuildInputs = [ pkgs.python314 ];
    env.PYTHONPATH = "${muelle}/${pkgs.python314.sitePackages}";
  }
  ''
    python3 - ${settings} <<'EOF'
    import json, sys
    from dataclasses import fields
    from muelle.config import Config, Site

    data = json.load(open(sys.argv[1]))
    errors = []

    def compare(what, keys, cls):
        names = {f.name for f in fields(cls)}
        if missing := names - keys:
            errors.append(f"{what}: {cls.__name__} fields not generated by the module: {sorted(missing)}")
        if extra := keys - names:
            errors.append(f"{what}: generated keys not in {cls.__name__}: {sorted(extra)}")

    compare("config", set(data), Config)
    for name, site in data["sites"].items():
        compare(f"sites.{name}", set(site), Site)
    if errors:
        sys.exit("\n".join(errors))

    config = Config.from_json(data)
    # null must stay None (any branch), not become the dataclass default
    assert config.sites["prodonly"].prod_branches is None, config.sites["prodonly"]
    assert config.sites["demo"].prod_branches == ("main",), config.sites["demo"]
    EOF
    touch $out
  ''
